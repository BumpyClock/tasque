#!/usr/bin/env bash
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

head=$(git rev-parse HEAD)
zero=${head//?/0}
seen=false
update=false
while read -r local_ref local_sha remote_ref remote_sha extra; do
    seen=true
    if [[ -z "$local_ref" || -z "$remote_ref" || -n "${extra:-}" || ${#local_sha} != ${#head} || ${#remote_sha} != ${#head} || "$local_sha$remote_sha" == *[!0-9a-f]* ]]; then
        echo 'pre-push: malformed ref record; refusing to skip checks.' >&2
        exit 1
    fi
    [[ "$local_sha" == "$zero" ]] && continue
    update=true
    if [[ "$(git rev-parse --verify "$local_sha^{commit}")" != "$head" ]]; then
        echo 'pre-push: switch to the pushed commit in a clean checkout first; only HEAD can be checked.' >&2
        exit 1
    fi
done
[[ "$seen" == true && "$update" == false ]] && exit 0

status=$(git status --porcelain --untracked-files=normal)
if [[ -n "$status" ]]; then
    echo 'pre-push: commit or move unrelated working-tree changes first. Nothing is stashed automatically.' >&2
    exit 1
fi
if ! command -v rustup >/dev/null || ! command -v bun >/dev/null || [[ ! -x tui-opentui/node_modules/.bin/tsc ]]; then
    echo 'pre-push: prepare Rust 1.97.1, cargo fetch --locked, and frozen Bun dependencies in tui-opentui first.' >&2
    exit 1
fi
# rustup run never installs a missing toolchain. No downloads during the hook.
if ! rustup run 1.97.1 rustc --version >/dev/null; then
    echo 'pre-push: install pinned Rust 1.97.1 with rustfmt/clippy before pushing.' >&2
    exit 1
fi

# Conservative full scopes cover config/dependencies, unknown bases and every ref.
rustup run 1.97.1 cargo fmt --all -- --check
rustup run 1.97.1 cargo clippy --offline --locked --all-targets --all-features -- -D warnings
(cd tui-opentui && bun run typecheck)
